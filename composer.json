{
    "name": "tatoeba/tatoeba",
    "type": "project",
    "license": "AGPL-3.0-only",
    "description": "Code for tatoeba.org, a multilingual sentence and translation database",
    "require": {
        "cakephp/cakephp": "5.2.*",
        "cakephp/plugin-installer": "^2.0",
        "dereuromark/cakephp-queue": "^8.0",
        "markstory/asset_compress": "^5.0",
        "patchwork/jsqueeze": "^2.0",
        "natxet/cssmin": "^3.0",
        "cakephp/migrations": "^4.0",
        "zircote/swagger-php": "^5.3",
        "doctrine/annotations": "^2.0",
        "cakedc/cakephp-cached-routing": "^2.0",
        "dereuromark/cakephp-tinyauth": "^5.0",
        "cakephp/authentication": "^3.0",
        "cakephp/authorization": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.5",
        "cakephp/bake": "^3.0",
        "helmich/phpunit-json-assert": "3.*",
        "robmorgan/phinx": "0.16.10"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "post-install-cmd": [
            "./vendor/bin/openapi --version 3.1.0 src/Controller/VHosts/Api/ src/Model/Behavior/ExposedOnApiBehavior.php -o webroot/api/openapi.json"
        ]
    },
    "config": {
        "allow-plugins": {
            "cakephp/plugin-installer": true
        }
    }
}
