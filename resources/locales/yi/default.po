msgid "There's no user called {username}"
msgstr "נישטאָ קיין באַניצער וואָס הייסט {username}"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/AudioController.php#L130
msgid "Your audio settings have been saved."
msgstr "אײַערע אוידיאָ־אײַנשטעלונגען זענען אויפֿגעהיטן געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/AudioController.php#L133
#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/LinksController.php#L109
msgid ""
"An error occurred while saving. Please try again or contact us to report "
"this."
msgstr "עס איז געשען אַ טעות בשעתן אויפֿהיטן. זײַט אַזוי גוט און פּרוּווט נאָך אַ מאָל, אָדער קאָנטאַקטירט אונדז כּדי צו מעלדן דאָס."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/LicensingController.php#L91
msgid "Please wait until the list is updated."
msgstr "זײַט אַזוי גוט און וואַרט ביז די רשימה ווערט באַנײַט."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/LicensingController.php#L95
msgid "A license switch is already in progress."
msgstr "אַ ליצענץ־בײַט גייט שוין אָן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/LinksController.php#L101
msgid ""
"Sentences #{firstNumber} and #{secondNumber} are now direct translations of "
"each other."
msgstr "די זאַצן #{firstNumber} און #{secondNumber} זענען איצט דירעקטע איבערזעצונגען איינס פֿונעם אַנדערן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/LinksController.php#L144
msgid ""
"Sentences #{firstNumber} and #{secondNumber} are no longer direct "
"translations of each other."
msgstr "די זאַצן #{firstNumber} און #{secondNumber} זענען מער נישט קיין דירעקטע איבערזעצונגען איינס פֿונעם אַנדערן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/LinksController.php#L152
msgid ""
"An error occurred while unlinking. Please try again or contact us to report "
"this."
msgstr "עס איז געשען אַ טעות בשעתן אָפּבינדן. זײַט אַזוי גוט און פּרוּווט נאָך אַ מאָל, אָדער קאָנטאַקטירט אונדז כּדי דאָס צו מעלדן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/PrivateMessagesController.php#L166
msgid "Folder \"{name}\" emptied."
msgstr "די פּאַפּקע „{name}” איז אויסגעליידיקט געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/ReportContentController.php#L26
msgid ""
"Thank you for your help. Your report was sent to the admins. If needed, they"
" will reply to you by private message."
msgstr "אַ דאַנק פֿאַר אײַער הילף. אײַער מעלדונג איז געשיקט געוואָרן צו די אַדמיניסטראַטאָרן. אויב נייטיק, וועלן זיי אײַך ענטפֿערן מיט אַ פּריוואַטן בריוול."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/ReportContentController.php#L34
msgid ""
"Sorry, we were unable to send your report. Please try again later, or "
"instead contact {email}."
msgstr "זײַט מוחל, מיר האָבן נישט געקענט שיקן אײַער מעלדונג. זײַט אַזוי גוט און פּרוּווט נאָך אַ מאָל שפּעטער, אָדער קאָנטאַקטירט אַנשטאָט דעם {email}."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SController.php#L60
#: github.com/Tatoeba/tatoeba2/tree/dev/templates/Sentences/show.php#L109
msgid "There is no sentence with id {number}"
msgstr "נישטאָ קיין זאַץ מיטן id {number}"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentenceCommentsController.php#L157
msgid "Your comment has been saved."
msgstr "אײַער באַמערקונג איז אויפֿגעהיטן געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentenceCommentsController.php#L200
msgid "You do not have permission to edit this comment. "
msgstr "איר האָט נישט קיין רשות צו רעדאַקטירן אָט די באַמערקונג. "

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentenceCommentsController.php#L204
#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/WallController.php#L244
#: github.com/Tatoeba/tatoeba2/tree/dev/templates/PrivateMessages/write.php#L55
msgid ""
"If you have received this message in error, please contact administrators at"
" {email}."
msgstr "אויב איר האָט באַקומען דאָס דאָזיקע בריוול דורך אַ טעות, זײַט אַזוי גוט און קאָנטאַקטירט די אַדמיניסטראַטאָרן בײַ {email}."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentenceCommentsController.php#L229
msgid "Changes to your comment have been saved."
msgstr "די בײַטן אין אײַער באַמערקונג זענען אויפֿגעהיטן געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesController.php#L217
msgid "The sentence #{id} has been deleted."
msgstr "דער זאַץ #{id} איז אויסגעמעקט געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesController.php#L223
msgid "Error: the sentence #{id} could not be deleted."
msgstr "טעות: דער זאַץ #{id} האָט נישט געקענט ווערן אויסגעמעקט."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesController.php#L818
msgid "You are not allowed to change the license of this sentence."
msgstr "עס איז אײַך נישט דערלויבט צו טוישן די ליצענץ פֿון דעם זאַץ."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesController.php#L825
msgid "The license of the sentence has been changed to “{newLicense}”."
msgstr "די ליצענץ פֿונעם זאַץ איז געביטן געוואָרן אויף „{newLicense}”."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesController.php#L830
msgid "Unable to change the license to “{newLicense}” because:"
msgstr "מע האָט נישט געקענט טוישן די ליצענץ אויף „{newLicense}” ווײַל:"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesListsController.php#L153
msgid "You do not have permission to view this list."
msgstr "איר האָט נישט קיין רשות צו זען די דאָזיקע רשימה."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesListsController.php#L306
msgid "The sentence could not be added to the list."
msgstr "דער זאַץ האָט נישט געקענט ווערן צוגעגעבן צו דער רשימה."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/SentencesListsController.php#L495
msgid "You do not have permission to download this list."
msgstr "איר האָט נישט קיין רשות צו אַראָפּלאָדן די דאָזיקע רשימה."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/TagsController.php#L236
msgid ""
"There are no sentences for this tag. The tag you are looking for has been "
"deleted or does not exist."
msgstr "עס זענען נישטאָ קיין זאַצן פֿאַר דעם צעטל. דער צעטל וואָס איר זוכט איז אויסגעמעקט געוואָרן, אָדער עקזיסטירט נישט."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L95
#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/VocabularyController.php#L75
msgid "No user with this username: {username}"
msgstr "נישטאָ קיין באַניצער מיט דעם באַניצער־נאָמען: {username}"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L144
msgid "Failed to upload image"
msgstr "מע האָט נישט געקענט אַרויפֿלאָדן דאָס בילד"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L153
msgid "Please choose an image that does not exceed 1 MB."
msgstr "זײַט אַזוי גוט און קלײַבט אויס אַ בילד וואָס איבערשרײַט נישט 1 מעגאַבײַט."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L164
msgid "Please choose GIF, JPEG or PNG image format."
msgstr "זײַט אַזוי גוט און קלײַבט אויס אַ בילד־פֿאָרמאַט: GIF, JPEG אָדער PNG."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L193
msgid "Error while saving."
msgstr "אַ טעות בשעתן אויפֿהיטן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L311
msgid "New password cannot be empty."
msgstr "דער נײַער פּאַראָל טאָר נישט זײַן ליידיק."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L314
msgid "New passwords do not match."
msgstr "די נײַע פּאַראָלן שטימען נישט איינע מיט דער אַנדערער."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L321
msgid "New password has been saved."
msgstr "דער נײַער פּאַראָל איז אויפֿגעהיטן געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L323
msgid "An error occurred while saving."
msgstr "עס איז געשען אַ טעות בשעתן אויפֿהיטן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L328
msgid "Password error. Please try again."
msgstr "אַ טעות מיטן פּאַראָל. זײַט אַזוי גוט און פּרוּווט נאָך אַ מאָל."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L393
msgid "Profile saved."
msgstr "דער פּראָפֿיל איז אויפֿגעהיטן געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L437
msgid "Your settings have been saved."
msgstr "אײַערע אײַנשטעלונגען זענען אויפֿגעהיטן געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UserController.php#L472
msgid "You have accepted the new terms of use."
msgstr "איר האָט מקבל געווען די נײַע באַניץ־באַדינגונגען."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L196
msgid "You must fill in your username and password."
msgstr "איר מוזט אויספֿילן אײַער באַניצער־נאָמען און פּאַראָל."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L204
msgid ""
"Login failed. Make sure that your Caps Lock and Num Lock are not "
"unintentionally turned on. Your password is case-sensitive."
msgstr "דער אַרײַנלאָג איז דורכגעפֿאַלן. פֿאַרזיכערט זיך, אַז אײַערע קלאַווישן Caps Lock און Num Lock זענען נישט אומגערן אָנגעשטעלט. אין אײַער פּאַראָל מאַכט אויס דער חילוק צווישן גרויסע און קליינע אותיות."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L309
msgid "Welcome to Tatoeba!"
msgstr "ברוכים־הבאים אין טאַטאָעבאַ!"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L313
msgid ""
"To start things off, we encourage you to read our <a href='{url}'>Quick "
"Start Guide</a>. If you want to read it later, you will find the link at the"
" bottom of any page on the website."
msgstr "כּדי אָנצוהייבן, רעקאָמענדירן מיר אײַך צו לייענען אונדזער <a href='{url}'>גיכן אָנהייב־מדריך</a>. אויב איר ווילט אים לייענען שפּעטער, וועט איר געפֿינען דעם לינק אונטן אויף יעדער זײַטל פֿון דער וועבזײַט."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L321
msgid "We hope you'll enjoy your time here with us!"
msgstr "מיר האָפֿן, אַז איר וועט הנאה האָבן פֿון אײַער צײַט דאָ בײַ אונדז!"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L332
msgid "Please fix the form errors."
msgstr "זײַט אַזוי גוט און פֿאַרריכט די טעותן אין דער פֿאָרעם."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L365
msgid "Your new password has been sent to {email}."
msgstr "אײַער נײַער פּאַראָל איז געשיקט געוואָרן צו {email}."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L370
msgid "You may need to check your spam folder to find this message."
msgstr "אפֿשר וועט איר דאַרפֿן קוקן אין אײַער ספּאַם־טעקע כּדי צו געפֿינען דאָס דאָזיקע בריוול."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L378
msgid "There is no registered user with this email address: "
msgstr "נישטאָ קיין רעגיסטרירטער באַניצער מיט דעם בליצבריוו־אַדרעס: "

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L401
msgid "No user with this username: "
msgstr "נישטאָ קיין באַניצער מיט דעם באַניצער־נאָמען: "

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersController.php#L437
msgid "No user with this ID: {id}"
msgstr "נישטאָ קיין באַניצער מיט דעם ID: {id}"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersLanguagesController.php#L74
msgid "This language has already been added to your profile."
msgstr "די דאָזיקע שפּראַך איז שוין צוגעגעבן געוואָרן צו אײַער פּראָפֿיל."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersLanguagesController.php#L89
msgid "You cannot save this language."
msgstr "איר קענט נישט אויפֿהיטן די דאָזיקע שפּראַך."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersLanguagesController.php#L125
msgid "Language deleted"
msgstr "די שפּראַך איז אויסגעמעקט געוואָרן"

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/UsersLanguagesController.php#L127
msgid "You cannot delete this language."
msgstr "איר קענט נישט אויסמעקן די דאָזיקע שפּראַך."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/VocabularyController.php#L138
msgid "The vocabulary item '{vocabText}' already exists for this language."
msgstr "דאָס וואָקאַבולאַר־שטיק „{vocabText}” עקזיסטירט שוין פֿאַר דער דאָזיקער שפּראַך."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/WallController.php#L141
msgid "Your message has been posted on the wall."
msgstr "אײַער בריוול איז אַרויפֿגעשטעלט געוואָרן אויף דער וואַנט."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/WallController.php#L221
msgid "Message saved."
msgstr "דאָס בריוול איז אויפֿגעהיטן געוואָרן."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/WallController.php#L241
msgid "You do not have permission to edit this message."
msgstr "איר האָט נישט קיין רשות צו רעדאַקטירן דאָס דאָזיקע בריוול."

#: github.com/Tatoeba/tatoeba2/tree/dev/src/Controller/WallController.php#L297
msgid "The message you are trying to view does not exist or has been deleted."
msgstr "דאָס בריוול וואָס איר פּרוּווט צו זען עקזיסטירט נישט, אָדער איז אויסגעמעקט געוואָרן."

#. This string will be preceded by “Warning:
#. the following criteria have been ignored:”
#: github.com/Tatoeba/tatoeba2/tree/dev/src/Form/SentencesSearchForm.php#L137
msgid "“sentence owner”, because “{username}” is not a valid username"
msgstr "„זאַץ־באַזיצער”, ווײַל „{username}” איז נישט קיין גילטיקער באַניצער־נאָמען"

#. This string will be preceded by
#. “Warning: the following criteria have been ignored:”
#: github.com/Tatoeba/tatoeba2/tree/dev/src/Form/SentencesSearchForm.php#L199
msgid "“translation owner”, because “{username}” is not a valid username"
